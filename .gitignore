.venv/
__pycache__/
*.pyc
preview_out/
config.toml
renderer/art_display
.DS_Store
._*

# Xcode build output (ios-companion) — 600M+ of DerivedData, regenerated on build
ios-companion/build/
ios-companion/build-device/
*.xcuserdatad/
*.pbxproj.bak

# web app build output and deps
web/node_modules/
web/.output/
web/.wrangler/
web/.nitro/
web/.tanstack/

# tessera iOS app build output (build-device is the on-device DerivedData —
# same 600M+ class of regenerated output as ios-companion's, never track it)
tessera/build/
tessera/build-device/
build-device/

# Xcode DerivedData from a simulator build at the repo root
/build/

# Blender backup saves
*.blend1

# Blender working files: one blend is tracked (design/renders/wall.blend);
# the enclosure variants regenerate from the same script with --enclosure
design/renders/covered.blend
design/renders/boxed.blend
design/renders/*.blend1
design/renders/console.blend
design/renders/vitrine.blend
design/renders/instrument.blend
design/renders/nonet.blend
design/renders/nonet-*.blend

# Test-run output: coverage's data file, and the sheet scripts/render_games.py
# draws (both regenerate, neither belongs in the tree)
.coverage
.coverage.*
htmlcov/
games-sheet.png

# The room's render passes: 654 frames, 420 MB, Blender output that ffmpeg
# turns into the .mov files staged in tessera/Tessera. The films ship; the
# frames are intermediates. room.py, render_all.sh and tt900-white.blend are
# tracked, so they regenerate (render_all.sh resumes from a named pass).
tessera/Tools/room/room-dive/
tessera/Tools/room/room-divelight/
tessera/Tools/room/room-intro/
tessera/Tools/room/room-lightfilm/
tessera/Tools/room/room-mark/
tessera/Tools/room/room-marklight/
tessera/Tools/room/room-needle/
