.venv/
__pycache__/
*.pyc
preview_out/
config.toml
renderer/art_display
.DS_Store
._*

# Xcode build output (ios-companion) — 600M+ of DerivedData, regenerated on build
ios-companion/build/
ios-companion/build-device/
*.xcuserdatad/
*.pbxproj.bak

# web app build output and deps
web/node_modules/
web/.output/
web/.wrangler/
web/.nitro/
web/.tanstack/

# tessera iOS app build output (build-device is the on-device DerivedData —
# same 600M+ class of regenerated output as ios-companion's, never track it)
tessera/build/
tessera/build-device/
build-device/
tessera/build/
tessera/build-device/

# Xcode DerivedData from a simulator build at the repo root
/build/

# Blender backup saves
*.blend1

# Blender working files: one blend is tracked (design/renders/wall.blend);
# the enclosure variants regenerate from the same script with --enclosure
design/renders/covered.blend
design/renders/boxed.blend
design/renders/*.blend1
design/renders/console.blend
design/renders/vitrine.blend
design/renders/instrument.blend
design/renders/nonet.blend
design/renders/nonet-*.blend

# Optional local fingerprint engine, rebuilt by pi/install-olaf.sh
/vendor/
/bin/
/models/
