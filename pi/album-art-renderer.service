[Unit]
Description=Album-Art Matrix renderer (FIFO frames -> HUB75 panels)
# The brain tolerates a missing renderer, but the wall does not: without this
# unit the panels stay dark after a reboot until run_renderer.sh is started by
# hand. Ordered before the brain so the fifo exists when the brain first writes.
Before=album-art-matrix.service

[Service]
User=pi
WorkingDirectory=/home/pi/album-art-matrix
ExecStart=/home/pi/album-art-matrix/pi/run_renderer.sh
Restart=on-failure
RestartSec=1
# gpio/video/render come from bootstrap.sh. Listed again so a fresh install
# that skipped the re-login still gets the device access.
SupplementaryGroups=gpio video render
# The driver pins its buffers with mlockall() and asks for SCHED_FIFO on the
# isolated core. A plain user gets 8 MB of lockable memory and no real-time
# priority, and the library die()s on the first of those ("mlockall failed",
# exit 1, found at first light 2026-09-06). Raise both for the unit here;
# bootstrap.sh does the same for interactive logins via limits.d.
LimitMEMLOCK=infinity
LimitRTPRIO=99

[Install]
WantedBy=multi-user.target
